{
  "command": ["/opt/scout-queue/.venv/bin/python", "-m", "scout_queue.mcp_server"],
  "cwd": "/opt/scout-queue",
  "client_id": "unique-scout-installation-id",
  "owner_id": "local-owner",
  "poll_seconds": 2,
  "wait_seconds": 300,
  "environment": {
    "SCOUT_ODOO_URL": "https://odoo.example.com",
    "SCOUT_ODOO_DB": "approved_database",
    "SCOUT_ODOO_UID": "7",
    "SCOUT_ODOO_COMPANY_IDS": "1",
    "SCOUT_ODOO_KEY_FILE": "/etc/scout/requester.key"
  }
}
